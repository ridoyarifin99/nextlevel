{
  "$schema": "https://openapi.vercel.sh/vercel.json",

"rewrites": [
    {
      "source": "/products/:slug*",
      "destination": "/api/product?slug=:slug*"
    },
    {
      "source": "/product/:slug*",
      "destination": "/api/product?slug=:slug*"
    },
{
  "rewrites": [
    { "source": "/product/(.*)", "destination": "/details.html" }
  ]
},
    {
      "source": "/(best-selling|streaming|music|storage|vpn|aiDesign|combos|education|adult)",
      "destination": "/index.html"
    }
  ]
}