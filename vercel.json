{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/dashboard.html", "destination": "/dashboard", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/register.html", "destination": "/signup", "permanent": true }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/register.html" },
    { "source": "/admin-products.html", "destination": "/api/admin-products-shell" },
    { "source": "/checkout.html", "destination": "/api/checkout-shell" },
    { "source": "/checkout", "destination": "/api/checkout-shell" },
    { "source": "/product/:slug*", "destination": "/api/product?slug=:slug*" },
    { "source": "/products/:slug*", "destination": "/api/product?slug=:slug*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/src/input.css", "destination": "/src/output.css" },
    { "source": "/best-selling", "destination": "/api/category?category=best-selling" },
    { "source": "/streaming", "destination": "/api/category?category=streaming" },
    { "source": "/music", "destination": "/api/category?category=music" },
    { "source": "/storage", "destination": "/api/category?category=storage" },
    { "source": "/vpn", "destination": "/api/category?category=vpn" },
    { "source": "/aiDesign", "destination": "/api/category?category=aiDesign" },
    { "source": "/combos", "destination": "/api/category?category=combos" },
    { "source": "/education", "destination": "/api/category?category=education" },
    { "source": "/adult", "destination": "/api/category?category=adult" }
  ]
}
