{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "rewrites": [
    {
      "source": "/product/:slug",
      "destination": "/api/product-view?slug=:slug"
    },
    {
      "source": "/products/:slug",
      "destination": "/api/product-view?slug=:slug"
    }
  ],
  "functions": {
    "api/product-view.js": {
      "includeFiles": [
        "details.html",
        "js/details.js",
        "api/seo-content.js"
      ]
    },
    "api/details-script.js": {
      "includeFiles": [
        "js/details.js"
      ]
    }
  }
}
