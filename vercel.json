{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/src/input.css",
      "destination": "/src/output.css"
    },
    {
      "source": "/(best-selling|streaming|music|storage|vpn|aiDesign|combos|education|adult)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/product/:slug*",
      "destination": "/details.html?name=:slug*",
      "permanent": false
    },
    {
      "source": "/products/:slug*",
      "destination": "/details.html?name=:slug*",
      "permanent": false
    }
  ]
}
