{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/product/:slug*",
      "destination": "/api/product-view?slug=:slug*"
    },
    {
      "source": "/products/:slug*",
      "destination": "/api/product-view?slug=:slug*"
    },
    {
      "source": "/(best-selling|streaming|music|storage|vpn|aiDesign|combos|education|adult)",
      "destination": "/index.html"
    }
  ]
}
