{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/home.js": {
      "includeFiles": "index.html"
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard.html",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/register.html",
      "destination": "/signup",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/register.html"
    },
    {
      "source": "/product/:slug*",
      "destination": "/api/product?slug=:slug*"
    },
    {
      "source": "/products/:slug*",
      "destination": "/api/product?slug=:slug*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/src/input.css",
      "destination": "/src/output.css"
    },
    {
      "source": "/(best-selling|streaming|music|storage|vpn|aiDesign|combos|education|adult)",
      "destination": "/index.html"
    }
  ]
}
