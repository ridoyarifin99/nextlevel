{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/product/:slug",
      "destination": "/api/product-view?slug=:slug"
    },
    {
      "source": "/products/:slug",
      "destination": "/api/product-view?slug=:slug"
    }
  ],
  "functions": {
    "api/product-view.js": {
      "includeFiles": "details.html"
    },
    "api/details-script.js": {
      "includeFiles": "js/details.js"
    }
  }
}
